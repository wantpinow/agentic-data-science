    {
      "id": "1cp4x5G447DB1ae4BQ0pj",
      "type": "text",
      "x": 176.17039379215362,
      "y": 4577.292184978646,
      "width": 1057.503662109375,
      "height": 980,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
